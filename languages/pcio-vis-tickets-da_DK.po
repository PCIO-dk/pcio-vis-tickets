msgid "No orders found."
msgstr "Ingen ordrer fundet."

msgid "No payment reference on this order — cannot refund via Stripe."
msgstr "Ingen betalingsreference på denne ordre — kan ikke refundere via Stripe."

msgid "No ticket types yet. Add one to start selling."
msgstr "Ingen billettyper endnu. Tilføj en for at begynde at sælge."

msgid "Nothing left to refund."
msgstr "Intet tilbage at refundere."

msgid "One of the selected tickets is not available."
msgstr "En af de valgte billetter er ikke tilgængelig."

msgid "Online payment is not available right now. Please contact the organiser."
msgstr "Onlinebetaling er ikke tilgængelig lige nu. Kontakt venligst arrangøren."

msgid "Only %2$d × “%1$s” are available."
msgstr "Kun %2$d × “%1$s” er tilgængelige."

msgid "Only confirmed orders can be resent."
msgstr "Kun bekræftede ordrer kan sendes igen."

msgid "Only entrance tickets count towards this limit. Sales stop automatically when it is reached."
msgstr "Kun adgangsbilletter tæller med i denne grænse. Salget stopper automatisk, når den er nået."

