msgstr "Billetsalg"

msgid "Refund order"
msgstr "Refunder ordre"

msgid "Up to the order total can be refunded. The maximum performs a full refund and releases the tickets."
msgstr "Op til ordrens fulde beløb kan refunderes. Maksimum udfører en fuld refundering og frigiver billetterne."

msgid "Order refunded."
msgstr "Ordre refunderet."

msgid "Refund failed."
msgstr "Refundering mislykkedes."

msgid "Resend confirmation"
msgstr "Send bekræftelse igen"

